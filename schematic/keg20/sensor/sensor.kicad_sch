	(text "External 5 V +-10 % (5.5 V max at U4). D1: reverse polarity,\nno feed from VSYS into J7. J7 also powers the keg20 board\nthrough J1-6 when it is connected."
		(exclude_from_sim no)
		(at 25.4 173.99 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9ba4f09f-a446-414c-b988-f828f8f5ec5c")
	)
	(text "U4 feeds ADC AVDD / VREF and the bridge;\nwith JP1 2-3 the whole board.\nInput 5.5 V max. Total output capacitance\n0.7-10 uF: 2.2 uF, with JP1 2-3 8.1 uF\n(adds C1 C2 C3 C7). Keep below 10 uF.\nR9 damps ringing when 5 V is plugged in."
		(exclude_from_sim no)
		(at 231.14 41.91 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9d196c0b-fca4-4f44-9a6f-394239a622a2")
	)
