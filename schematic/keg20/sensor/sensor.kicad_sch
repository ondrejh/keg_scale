	(text "TEST is tied to ESP_TXD through JP3 (BSL entry over UART).\nPower-up with TEST high: reset with TEST low to start.\nNo capacitor on RST: max 1.1 nF with Spy-Bi-Wire."
		(exclude_from_sim no)
		(at 50.8 110.49 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e32078b4-aa3e-4144-89e3-4499ab52f4ee")
	)
	(text "JP2 closed = one-wire UART on ESP_TXD (J1-3):\nMSP TXD pulls low through D2, R7 pulls up\n(4k7: TEST has a 20-50k internal pull-down).\nHost must be open-drain (never push-pull).\nJP2 open (default) = two-wire UART and BSL."
		(exclude_from_sim no)
		(at 52.07 123.19 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e6e1e945-855e-4907-b54b-209adf85774a")
	)
	(text "J1 -> keg20 board header J1:\n1 +3V3 -> 6   2 ESP_RXD (GPIO17) -> 12\n3 ESP_TXD (GPIO16) -> 11   4 ESP_RST (GPIO9) -> 4\n5 GND -> 5   6 +5V (VSYS) -> 2\nStandalone: pins 3-6 only, JP1 2-3, JP2 closed"
		(exclude_from_sim no)
		(at 25.4 63.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f626a881-aca8-43b5-98fe-e3d9d6f524a8")
	)
	(text "WHITE"
		(exclude_from_sim no)
		(at 256.54 157.988 90)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right)
		)
		(uuid "ff5e624e-99bc-49c4-9a35-02f3a0214a27")
	)
